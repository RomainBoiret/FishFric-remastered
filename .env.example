# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# Never put real passwords or AUTH_SECRET in this file — it is committed to git.
# Real values go in `.env` (local), Vercel env vars, and GitHub Actions secrets.

# Neon pooled connection (app runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon direct connection (migrations only — host WITHOUT `-pooler`)
# Also add DATABASE_URL + DIRECT_URL as GitHub Actions secrets for
# `.github/workflows/migrate-production.yml`
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js session + HMAC secret for signed demo cheques
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Protects POST /api/demo/reset (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# Generate the same way as AUTH_SECRET. Set on Vercel for production cron.
# CRON_SECRET="replace-with-a-long-random-string"
# Optional alias for manual curls (same or different value):
# DEMO_RESET_SECRET="replace-with-a-long-random-string"

# Optional canonical site URL (metadata, sitemap, JSON-LD)
# NEXT_PUBLIC_SITE_URL="https://your-deployment.vercel.app"
